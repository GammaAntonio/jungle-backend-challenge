{
  "name": "jungle-wagering",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "bun src/main.ts",
    "worker": "bun src/worker.ts",
    "migrate": "bun scripts/migrate.ts up",
    "migrate:down": "bun scripts/migrate.ts down",
    "init:sqs": "bun scripts/init-sqs.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration --timeout 60000",
    "test:concurrency": "bun test test/concurrency --timeout 60000",
    "test:all": "bun run typecheck \u0026\u0026 bun run test:unit \u0026\u0026 bun run test:integration \u0026\u0026 bun run test:concurrency",
    "format:check": "prettier --check src scripts test"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@aws-sdk/client-sqs": "^3.900.0",
    "typeorm": "^0.3.27",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.15.0",
    "typescript": "^5.9.0",
    "prettier": "^3.6.0"
  }
}
